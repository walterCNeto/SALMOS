\babel@toc {brazil}{}\relax 
\contentsline {figure}{\numberline {1}{\ignorespaces Composição do balanço patrimonial por categoria de ativo e passivo. O crédito representa 64,44\% do ativo total; CDB e depósitos respondem pela maior fatia do \textit {funding}.}}{9}{figure.caption.5}%
\contentsline {figure}{\numberline {2}{\ignorespaces Distribuição do RWA por categoria de ativo e posição de capital. O crédito a pessoas físicas e jurídicas representa a maior parcela do ativo ponderado pelo risco.}}{10}{figure.caption.7}%
\contentsline {figure}{\numberline {3}{\ignorespaces Mix de indexadores --- ativo vs.\ passivo. No ativo, 58,2\% é indexado ao CDI; no passivo, 60,5\%. A posição em IPCA é assimétrica: o passivo detém proporção maior, criando exposição líquida a inflação.}}{11}{figure.caption.8}%
\contentsline {figure}{\numberline {4}{\ignorespaces Curvas de juros DI e IPCA para os três cenários. A curva base apresenta leve inversão para prazos intermediários, refletindo expectativa de queda gradual da SELIC.}}{12}{figure.caption.10}%
\contentsline {figure}{\numberline {5}{\ignorespaces \textit {Spreads} de crédito por segmento nos três cenários (escala logarítmica). No cenário de estresse de alta, os \textit {spreads} ampliam-se, refletindo deterioração das condições de crédito e aumento do prêmio de risco.}}{13}{figure.caption.11}%
\contentsline {figure}{\numberline {6}{\ignorespaces Gap de reprecificação por \textit {bucket}: barras representam volumes de ativo (azul) e passivo (vermelho) por prazo; a linha tracejada representa o gap cumulativo.}}{15}{figure.caption.13}%
\contentsline {figure}{\numberline {7}{\ignorespaces NII mensal acumulado para os três cenários de taxa de juros. A estabilidade relativa reflete o alto grau de indexação ao CDI em ambos os lados do balanço.}}{16}{figure.caption.15}%
\contentsline {figure}{\numberline {8}{\ignorespaces NIM (\% a.a.) por cenário ao longo dos 12 meses de projeção. O NIM mantém-se entre 11,40\% e 11,53\% entre os cenários de alta e baixa, respectivamente.}}{16}{figure.caption.16}%
\contentsline {figure}{\numberline {9}{\ignorespaces DV01 por produto e \textit {duration} modificada média. A carteira de crédito imobiliário e os títulos NTN-B longa concentram o maior DV01 do ativo.}}{17}{figure.caption.17}%
\contentsline {figure}{\numberline {10}{\ignorespaces Sensibilidade do NII a choques paralelos de $-300$ a $+300$ bps, metodologia IRRBB \citep {BCBS368}. A linearidade próxima reflete a predominância de instrumentos CDI, que repreci\-ficam rapidamente.}}{18}{figure.caption.18}%
\contentsline {figure}{\numberline {11}{\ignorespaces Fronteira eficiente NII $\times $ DV01 gap. Os três pontos destacados correspondem às estratégias de máximo NII ($\lambda = 0{,}0001$), equilíbrio ($\lambda = 0{,}01$) e mínimo risco ($\lambda = 1{,}0$).}}{21}{figure.caption.20}%
\contentsline {figure}{\numberline {12}{\ignorespaces Volume de crédito novo por segmento para as três estratégias. O otimizador aloca sistematicamente em crédito pessoal, veículos e PJ, nunca em imobiliário ou rural (RAROC negativo no modelo).}}{21}{figure.caption.21}%
\contentsline {figure}{\numberline {13}{\ignorespaces Mix de captação nova ótima por instrumento. A preferência por CDB CDI longo e LF IPCA reflete menor custo e contribuição positiva para o NSFR.}}{22}{figure.caption.22}%
\contentsline {figure}{\numberline {14}{\ignorespaces Atendimento às restrições regulatórias pós-otimização para as três estratégias. O NSFR é a restrição ativa (\textit {binding}) em todas as soluções; LCR e Índice de Basileia mantêm folga substancial.}}{22}{figure.caption.23}%
\contentsline {figure}{\numberline {15}{\ignorespaces Posição nocional de hedge e DV01 gap resultante por estratégia. A estratégia de mínimo risco utiliza o limite máximo de nocional em futuros DI e \textit {swaps} DI$\times $Pré.}}{23}{figure.caption.24}%
\contentsline {figure}{\numberline {16}{\ignorespaces Decomposição do \textit {stress test} LCR: composição HQLA por nível regulatório e principais \textit {outflows} líquidos em cenário de estresse. LCR de 1.311\% indica buffer muito acima do mínimo exigido.}}{24}{figure.caption.26}%
\contentsline {figure}{\numberline {17}{\ignorespaces Projeção dinâmica de LCR e NSFR ao longo de 12 meses para os três cenários de crescimento. O NSFR comprime-se mais rapidamente e torna-se a restrição ativa (\textit {binding}) no otimizador.}}{24}{figure.caption.27}%
\contentsline {figure}{\numberline {18}{\ignorespaces Custo de carregamento por produto HQLA (R\$\,M/ano). LFT e compulsório respondem pela maior parte do custo de oportunidade total de R\$\,9.400\,M/ano.}}{25}{figure.caption.28}%
\contentsline {figure}{\numberline {19}{\ignorespaces RAROC por segmento de negócio versus \textit {hurdle rate} de 15\%. Segmentos à esquerda da linha vermelha destroem valor econômico (EVA negativo).}}{26}{figure.caption.30}%
\contentsline {figure}{\numberline {20}{\ignorespaces Comparação entre taxa atual e taxa mínima econômica por segmento, e capital econômico como percentual do EAD. Segmentos regulados (imobiliário, rural) são mantidos por exigências de crédito direcionado \citep {Bonomo2016}, não por retorno econômico.}}{27}{figure.caption.32}%
